// FitFlow Gym SaaS - Multi-Tenant Relational Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  TRAINER
  RECEPTION
  MEMBER
}

enum AttendanceMethod {
  QR
  BIOMETRIC
  MANUAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
  FAILED
  REFUNDED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// --------------------------------------------------------
// MULTI-TENANT CORE ENTITIES
// --------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  logoUrl     String?
  address     String?
  gstNumber   String?
  tier                  String    @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  isActive              Boolean   @default(true)
  subscriptionPlan      String    @default("FREE")    // FREE, SILVER, GOLD, CUSTOM
  subscriptionExpiresAt DateTime?
  subscriptionStatus    String    @default("ACTIVE")  // ACTIVE, EXPIRED, CANCELLED
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  branches        Branch[]
  users           User[]
  members         Member[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  payments        Payment[]
  qrCodes         QRCode[]
  attendances     Attendance[]
  trainers        Trainer[]
  workoutPlans    WorkoutPlan[]
  dietPlans       DietPlan[]
  followUpTasks   FollowUpTask[]
  badges          Badge[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  capacity       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members       Member[]
  attendances   Attendance[]
  followUpTasks FollowUpTask[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  email          String       @unique
  name           String
  passwordHash   String
  role           UserRole     @default(OWNER)
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedTasks FollowUpTask[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Member {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  memberCode        String       // Format: GYM-BRANCH-000001
  name              String
  phone             String
  email             String?
  dateOfBirth       DateTime?
  gender            String?
  height            Float?       // cm
  weight            Float?       // kg
  fitnessGoal       String?
  profilePhotoUrl   String?
  riskScore         Int          @default(0) // 0-100 Churn Risk Score (FitFlow Moat)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  qrCode        QRCode?
  membership    Membership?
  attendances   Attendance[]
  payments      Payment[]
  badges        MemberBadge[]
  workoutPlans  WorkoutPlan[]
  dietPlans     DietPlan[]
  followUpTasks FollowUpTask[]

  @@unique([organizationId, branchId, phone])
  @@unique([organizationId, memberCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([riskScore])
  @@map("members")
}

model QRCode {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String       @unique
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  token          String       @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([token])
  @@map("qr_codes")
}

model Attendance {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  entryTime       DateTime         @default(now())
  exitTime        DateTime?
  durationMinutes Int?
  method          AttendanceMethod @default(QR)
  isRoaming       Boolean          @default(false)
  homeBranchId    String?

  @@index([organizationId, entryTime])
  @@index([memberId, entryTime])
  @@index([branchId, entryTime])
  @@map("attendance")
}

model MembershipPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  durationDays   Int
  price          Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships Membership[]

  @@index([organizationId])
  @@map("membership_plans")
}

model Membership {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId           String           @unique
  member             Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId             String?
  plan               MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  customPlanName     String?
  customPrice        Decimal?         @db.Decimal(10, 2)
  customDurationDays Int?
  isCustom           Boolean          @default(false)
  startDate          DateTime
  expiryDate         DateTime
  status             MembershipStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId])
  @@index([expiryDate])
  @@map("memberships")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PAID)
  invoiceNumber  String?       @unique
  paidAt         DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, paidAt])
  @@index([memberId])
  @@map("payments")
}

// --------------------------------------------------------
// PHASE 1.5: GAMIFICATION & TRAINERS
// --------------------------------------------------------

model Badge {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // E.g., "7-Day Streak", "Century Club 100"
  description    String
  icon           String       // Icon key
  minVisits      Int          @default(1)
  createdAt      DateTime     @default(now())

  members MemberBadge[]

  @@index([organizationId])
  @@map("badges")
}

model MemberBadge {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([memberId, badgeId])
  @@map("member_badges")
}

model Trainer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String
  specialty      String?      // E.g. "Strength & Conditioning", "Weight Loss"
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedMembers Member[]

  @@index([organizationId])
  @@map("trainers")
}

model WorkoutPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title          String       // E.g. "4-Day Hypertrophy Split"
  description    String?
  scheduleJson   String       // Stored JSON schedule of days, exercises, sets, reps
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@map("workout_plans")
}

model DietPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title          String       // E.g. "High Protein Caloric Deficit"
  dailyCalories  Int          @default(2000)
  proteinGrams   Int          @default(150)
  carbsGrams     Int          @default(200)
  fatsGrams      Int          @default(60)
  mealsJson      String       // Stored JSON of meals and snacks
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@map("diet_plans")
}

// --------------------------------------------------------
// PHASE 1.5+: RETENTION CRM & CHURN ENGINE (FITFLOW MOAT)
// --------------------------------------------------------

model FollowUpTask {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  title          String       // E.g. "Call Rahul - Inactive for 8 days"
  reason         String       // "ABSENCE_7_DAYS", "EXPIRING_SOON", "MISSED_WORKOUT"
  notes          String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  dueDate        DateTime
  completedAt    DateTime?
  outcomeNotes   String?      // Call outcome e.g. "Member had fever, returning Monday"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([memberId])
  @@index([branchId])
  @@map("follow_up_tasks")
}
