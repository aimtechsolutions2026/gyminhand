# FitFlow Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitflow_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="fitflow-super-secret-jwt-key-replace-in-production-min-32-chars"

# Razorpay (Phase 1.5)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_rzp_secret"

# Cloudinary (Phase 1 - Week 3 for logos & photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email - SendGrid (Phase 1.5)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@fitflow.app"

